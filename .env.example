# --- PayPal sandbox (required) ---
# developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID for INVOICING.INVOICE.PAID and INVOICING.INVOICE.CANCELLED.
# Not needed when DEMO_MODE=true.
PAYPAL_WEBHOOK_ID=

# --- Claude underwriting review (optional; rules only without it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Behaviour ---
# Adds /demo/* endpoints and dashboard buttons that simulate the client paying.
DEMO_MODE=true
# Give your PayPal sandbox buyer account a payment history so Advance will finance invoices
# sent to it. Format: email=profile (reliable, slow, risky or new), comma-separated.
DEMO_CLIENTS=
# Optional shared key for the JSON API (the webhook is verified by PayPal's signature instead).
API_KEY=
# Optional: persist state to a JSON file so it survives restarts.
DATA_FILE=./state.json
MAX_INVOICE_CENTS=500000
MAX_EXPOSURE_CENTS=2000000
DEFAULT_AFTER_DAYS=60

# --- Server ---
# PORT or ADDR (default :8080)
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
